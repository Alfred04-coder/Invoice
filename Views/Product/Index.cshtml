
@model IEnumerable<InvoiceManagement.Models.Product>

@{
    ViewData["Title"] = "Products";
    var products = Model?.ToList() ?? new List<InvoiceManagement.Models.Product>();
}

<style>
    .dashboard-page {
        background: #f4f4f4;
        min-height: 100vh;
        color: #171717;
        padding-bottom: 40px;
    }

    .dashboard-navbar {
        background: #080808;
        border-bottom: 3px solid #333;
    }

        .dashboard-navbar .navbar-brand {
            color: #fff;
            letter-spacing: -.3px;
            font-size: 1.25rem;
        }

        .dashboard-navbar .brand-mark {
            display: inline-flex;
            width: 36px;
            height: 36px;
            align-items: center;
            justify-content: center;
            background: #fff;
            color: #080808;
            border-radius: 10px;
            margin-right: 8px;
        }

        .dashboard-navbar .nav-link {
            color: #d0d0d0;
            font-size: .88rem;
            font-weight: 600;
            padding: 12px 13px !important;
            border-radius: 7px;
            transition: .2s ease;
        }

            .dashboard-navbar .nav-link:hover,
            .dashboard-navbar .nav-link.active {
                background: #292929;
                color: #fff;
            }

            .dashboard-navbar .nav-link.new-invoice {
                background: #fff;
                color: #111;
                margin-left: 4px;
            }

                .dashboard-navbar .nav-link.new-invoice:hover {
                    background: #e5e5e5;
                    color: #000;
                }

            .dashboard-navbar .nav-link.logout-link {
                color: #ffb8b8;
            }

                .dashboard-navbar .nav-link.logout-link:hover {
                    background: #351818;
                    color: #fff;
                }

    .dashboard-content {
        padding: 28px 0;
    }

    .dashboard-title {
        font-size: clamp(1.5rem, 2vw, 2rem);
        font-weight: 800;
        letter-spacing: -.7px;
        color: #101010;
        margin-bottom: 5px;
    }

    .dashboard-subtitle {
        color: #737373;
        margin-bottom: 0;
        font-size: .93rem;
    }

    .date-chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 14px;
        background: #fff;
        border: 1px solid #dedede;
        border-radius: 10px;
        color: #333;
        font-size: .86rem;
        font-weight: 650;
    }
    body {
        background-color: #f4f5f7;
    }

    .products-page {
        padding: 30px 0;
    }

    .page-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
        margin-bottom: 25px;
    }

        .page-heading h2 {
            font-weight: 750;
            color: #111827;
            margin-bottom: 6px;
            letter-spacing: -0.6px;
        }

    .page-subtitle {
        color: #6b7280;
        font-size: 14px;
        margin-bottom: 0;
    }

    .products-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.04);
    }

    .products-toolbar {
        padding: 20px 22px;
        border-bottom: 1px solid #e5e7eb;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 15px;
    }

    .search-box {
        width: 100%;
        max-width: 420px;
    }

        .search-box .form-control {
            min-height: 44px;
            border: 1px solid #d1d5db;
            border-radius: 9px 0 0 9px;
            font-size: 14px;
        }

            .search-box .form-control:focus {
                border-color: #111827;
                box-shadow: 0 0 0 3px rgba(17, 24, 39, 0.08);
            }

        .search-box .btn {
            border-radius: 0 9px 9px 0;
        }

    .btn-dark-custom {
        background: #111827;
        color: #fff;
        border: 1px solid #111827;
        border-radius: 9px;
        padding: 10px 16px;
        font-weight: 600;
        font-size: 13px;
        transition: 0.2s ease;
    }

        .btn-dark-custom:hover {
            background: #000;
            color: #fff;
            transform: translateY(-1px);
        }

    .product-count {
        color: #6b7280;
        font-size: 13px;
        white-space: nowrap;
    }

        .product-count strong {
            color: #111827;
        }

    .table-responsive {
        overflow-x: auto;
    }

    .products-table {
        margin-bottom: 0;
        vertical-align: middle;
        min-width: 850px;
    }

        .products-table thead th {
            background: #111827;
            color: #fff;
            padding: 15px 16px;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.7px;
            font-weight: 650;
            white-space: nowrap;
            border: none;
        }

        .products-table tbody td {
            padding: 16px;
            font-size: 13px;
            color: #374151;
            border-color: #f0f1f3;
        }

        .products-table tbody tr:hover {
            background: #f9fafb;
        }

    .product-name {
        font-weight: 650;
        color: #111827;
    }

    .price-text {
        font-weight: 600;
        color: #111827;
        white-space: nowrap;
    }

    .stock-badge {
        display: inline-block;
        padding: 6px 10px;
        border-radius: 7px;
        font-size: 12px;
        font-weight: 650;
        white-space: nowrap;
    }

    .stock-good {
        background: #dcfce7;
        color: #166534;
    }

    .stock-low {
        background: #fef3c7;
        color: #92400e;
    }

    .stock-empty {
        background: #fee2e2;
        color: #991b1b;
    }

    .description-cell {
        max-width: 200px;
        color: #6b7280 !important;
    }

    .action-buttons {
        display: flex;
        gap: 7px;
        white-space: nowrap;
    }

    .btn-action {
        border-radius: 7px;
        font-size: 12px;
        font-weight: 600;
        padding: 7px 10px;
    }

    .btn-stock {
        background: #111827;
        color: #fff;
        border: 1px solid #111827;
    }

        .btn-stock:hover {
            background: #000;
            color: #fff;
        }

    .btn-edit {
        background: #fff;
        color: #374151;
        border: 1px solid #d1d5db;
    }

        .btn-edit:hover {
            background: #f3f4f6;
            color: #111827;
            border-color: #9ca3af;
        }

    .empty-state {
        padding: 55px 20px !important;
        text-align: center;
    }

    .empty-icon {
        width: 64px;
        height: 64px;
        border-radius: 18px;
        background: #f3f4f6;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 15px;
        font-size: 27px;
        color: #6b7280;
    }

    .products-footer {
        padding: 14px 22px;
        background: #fafafa;
        border-top: 1px solid #e5e7eb;
        color: #6b7280;
        font-size: 12px;
    }

    @@media (max-width: 576px) {
        .products-page {
            padding: 20px 0;
        }

        .page-heading {
            align-items: flex-start;
        }

        .products-toolbar {
            padding: 16px;
        }

        .search-box {
            max-width: 100%;
        }
    }
</style>

<div class="container-fluid products-page">
    <nav class="navbar navbar-expand-xl navbar-dark dashboard-navbar">
        <div class="container-fluid px-3 px-lg-4">
            <a class="navbar-brand fw-bold d-flex align-items-center"
               asp-controller="Admin" asp-action="Dashboard">
                <span class="brand-mark"><i class="bi bi-receipt-cutoff"></i></span>
                MyInvoice
            </a>

            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar" aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav me-auto my-2 my-xl-0 gap-xl-1">
                    <li class="nav-item">
                        <a class="nav-link active" asp-controller="Admin" asp-action="Dashboard">
                            <i class="bi bi-grid-1x2-fill me-1"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Admin" asp-action="SalesList">
                            <i class="bi bi-receipt me-1"></i> Sales
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Admin" asp-action="Debtors">
                            <i class="bi bi-wallet2 me-1"></i> Customer Debts
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Product" asp-action="Index">
                            <i class="bi bi-box-seam me-1"></i> Products
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Product" asp-action="StockSummary">
                            <i class="bi bi-clipboard-data me-1"></i> Stock Summary
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link new-invoice" asp-controller="Staff" asp-action="Create">
                            <i class="bi bi-plus-lg me-1"></i> New Invoice
                        </a>
                    </li>
                </ul>

                <ul class="navbar-nav ms-xl-2">
                    <li class="nav-item">
                        <a class="nav-link logout-link" asp-controller="Account" asp-action="LogIn">
                            <i class="bi bi-box-arrow-right me-1"></i> Logout
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Page Heading -->
    <div class="page-heading">
        <div>
            <h2>
                <i class="bi bi-box-seam me-2"></i>Products
            </h2>
            <p class="page-subtitle">
                Manage your product catalogue, prices and stock levels.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-dark-custom">
            <i class="bi bi-plus-lg me-2"></i>Add New Product
        </a>
    </div>

    <!-- Products Card -->
    <div class="products-card">

        <div class="products-toolbar">
            <form asp-action="Index" method="get" class="search-box">
                <div class="input-group">
                    <input type="text"
                           name="searchString"
                           value="@Context.Request.Query["searchString"]"
                           class="form-control"
                           placeholder="Search by product name..."
                           aria-label="Search products" />

                    <button type="submit" class="btn btn-dark-custom">
                        <i class="bi bi-search me-1"></i>Search
                    </button>
                </div>
            </form>

            <div class="product-count">
                <i class="bi bi-collection me-1"></i>
                Products displayed: <strong>@products.Count</strong>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table products-table">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Cost Price</th>
                        <th>Selling Price</th>
                        <th>Stock Level</th>
                        <th>Description</th>
                        <th>Expiry Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (products.Any())
                    {
                        @foreach (var item in products)
                        {
                            <tr>
                                <td>
                                    <div class="product-name">
                                        <i class="bi bi-box me-2 text-secondary"></i>
                                        @item.Name
                                    </div>
                                </td>

                                <td class="price-text">
                                    @item.CostPrice.ToString("C")
                                </td>

                                <td class="price-text">
                                    @item.SellingPrice.ToString("C")
                                </td>

                                <td>
                                    @if (item.QuantityInStock <= 0)
                                    {
                                        <span class="stock-badge stock-empty">
                                            <i class="bi bi-x-circle me-1"></i>Out of stock
                                        </span>
                                    }
                                    else if (item.QuantityInStock < 10)
                                    {
                                        <span class="stock-badge stock-low">
                                            <i class="bi bi-exclamation-triangle me-1"></i>
                                            @item.QuantityInStock Low
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="stock-badge stock-good">
                                            <i class="bi bi-check-circle me-1"></i>
                                            @item.QuantityInStock In stock
                                        </span>
                                    }
                            </td>

                            <td class="description-cell">
                                @(string.IsNullOrWhiteSpace(item.Description)
                                                            ? "—"
                                                            : item.Description)
                        </td>

@*                                 <td>
                                    @(item.ExpiryDate?.ToString("dd MMM yyyy") ?? "—")
                                </td> *@

                                <td>
                                    <div class="action-buttons">
                                        <a asp-action="AddStock"
                                           asp-route-productId="@item.ProductId"
                                           class="btn btn-action btn-stock">
                                            <i class="bi bi-plus-circle me-1"></i>Stock
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-productId="@item.ProductId"
                                           class="btn btn-action btn-edit">
                                            <i class="bi bi-pencil-square me-1"></i>Edit
                                        </a>
                                    </div>
                                </td>
                            </tr>
                                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="empty-state">
                                <div class="empty-icon">
                                    <i class="bi bi-box-seam"></i>
                                </div>

                                <h5 class="fw-bold text-dark">No products found</h5>

                                <p class="text-secondary small mb-3">
                                    Try another search or add a new product to your catalogue.
                                </p>

                                <a asp-action="Create" class="btn btn-dark-custom">
                                    <i class="bi bi-plus-lg me-2"></i>Add Product
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="products-footer d-flex justify-content-between flex-wrap gap-2">
            <span>
                <i class="bi bi-shield-check me-1"></i>
                Product Inventory
            </span>

            <span>
                Showing @products.Count product(s)
            </span>
        </div>

    </div>
</div>
