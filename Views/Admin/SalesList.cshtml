@model IEnumerable<InvoiceManagement.ViewModel.InvoiceListViewModel>

@{
    ViewData["Title"] = "Sales List";

    var sales = Model?.ToList() ?? new List<InvoiceManagement.ViewModel.InvoiceListViewModel>();
    decimal totalSales = Convert.ToDecimal(ViewBag.TotalSales ?? 0);
}

<style>
    .dashboard-page {
        background: #f4f4f4;
        min-height: 100vh;
        color: #171717;
        padding-bottom: 40px;
    }

    .dashboard-navbar {
        background: #080808;
        border-bottom: 3px solid #333;
    }

        .dashboard-navbar .navbar-brand {
            color: #fff;
            letter-spacing: -.3px;
            font-size: 1.25rem;
        }

        .dashboard-navbar .brand-mark {
            display: inline-flex;
            width: 36px;
            height: 36px;
            align-items: center;
            justify-content: center;
            background: #fff;
            color: #080808;
            border-radius: 10px;
            margin-right: 8px;
        }

        .dashboard-navbar .nav-link {
            color: #d0d0d0;
            font-size: .88rem;
            font-weight: 600;
            padding: 12px 13px !important;
            border-radius: 7px;
            transition: .2s ease;
        }

            .dashboard-navbar .nav-link:hover,
            .dashboard-navbar .nav-link.active {
                background: #292929;
                color: #fff;
            }

            .dashboard-navbar .nav-link.new-invoice {
                background: #fff;
                color: #111;
                margin-left: 4px;
            }

                .dashboard-navbar .nav-link.new-invoice:hover {
                    background: #e5e5e5;
                    color: #000;
                }

            .dashboard-navbar .nav-link.logout-link {
                color: #ffb8b8;
            }

                .dashboard-navbar .nav-link.logout-link:hover {
                    background: #351818;
                    color: #fff;
                }

    .dashboard-content {
        padding: 28px 0;
    }

    .dashboard-title {
        font-size: clamp(1.5rem, 2vw, 2rem);
        font-weight: 800;
        letter-spacing: -.7px;
        color: #101010;
        margin-bottom: 5px;
    }

    .dashboard-subtitle {
        color: #737373;
        margin-bottom: 0;
        font-size: .93rem;
    }

    .date-chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 14px;
        background: #fff;
        border: 1px solid #dedede;
        border-radius: 10px;
        color: #333;
        font-size: .86rem;
        font-weight: 650;
    }
    .sales-page {
        background: #f2f2f2;
        min-height: 100vh;
        padding: 28px 0 45px;
        color: #171717;
    }

        .sales-page .page-title {
            font-size: 1.65rem;
            font-weight: 750;
            letter-spacing: -.5px;
            color: #000;
        }

        .sales-page .page-subtitle {
            color: #707070;
            font-size: .92rem;
        }

        .sales-page .summary-card {
            background: #fff;
            border: 1px solid #dedede;
            border-top: 4px solid #111;
            border-radius: 12px;
            padding: 22px;
            box-shadow: 0 4px 14px rgba(0, 0, 0, .05);
        }

        .sales-page .summary-label {
            color: #666;
            font-size: .83rem;
            font-weight: 600;
            margin-bottom: 9px;
        }

        .sales-page .summary-value {
            color: #000;
            font-size: 1.7rem;
            font-weight: 800;
            overflow-wrap: anywhere;
        }

        .sales-page .summary-icon {
            width: 48px;
            height: 48px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #111;
            color: #fff;
            font-size: 1.35rem;
            flex-shrink: 0;
        }

        .sales-page .content-card {
            background: #fff;
            border: 1px solid #dedede;
            border-radius: 13px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, .06);
            overflow: hidden;
        }

        .sales-page .card-heading {
            padding: 21px 24px;
            border-bottom: 1px solid #ddd;
            background: #fff;
        }

        .sales-page .filter-panel {
            padding: 20px 24px;
            background: #fafafa;
            border-bottom: 1px solid #e5e5e5;
        }

        .sales-page .form-label {
            font-size: .82rem;
            font-weight: 650;
            color: #333;
            margin-bottom: 7px;
        }

        .sales-page .form-control,
        .sales-page .form-select {
            border: 1px solid #ccc;
            border-radius: 8px;
            padding: 10px 12px;
            font-size: .88rem;
            color: #222;
        }

            .sales-page .form-control:focus,
            .sales-page .form-select:focus {
                border-color: #111;
                box-shadow: 0 0 0 3px rgba(0, 0, 0, .08);
            }

        .sales-page .btn-black {
            background: #111;
            color: #fff;
            border: 1px solid #111;
            border-radius: 8px;
            padding: 10px 17px;
            font-weight: 600;
            transition: .2s;
        }

            .sales-page .btn-black:hover {
                background: #333;
                color: #fff;
            }

        .sales-page .btn-outline-black {
            background: #fff;
            color: #111;
            border: 1px solid #111;
            border-radius: 8px;
            padding: 10px 15px;
            font-weight: 600;
            text-decoration: none;
        }

            .sales-page .btn-outline-black:hover {
                background: #111;
                color: #fff;
            }

        .sales-page .table {
            margin-bottom: 0;
            white-space: nowrap;
        }

            .sales-page .table thead th {
                background: #111;
                color: #fff;
                padding: 16px 18px;
                font-size: .75rem;
                font-weight: 700;
                letter-spacing: .5px;
                text-transform: uppercase;
                border: none;
            }

            .sales-page .table tbody td {
                padding: 17px 18px;
                border-color: #e8e8e8;
                font-size: .88rem;
                color: #292929;
                vertical-align: middle;
            }

            .sales-page .table tbody tr:hover td {
                background: #f7f7f7;
            }

        .sales-page .invoice-number {
            font-weight: 750;
            color: #000;
        }

        .sales-page .customer-name {
            font-weight: 650;
            color: #222;
        }

        .sales-page .amount {
            font-weight: 750;
            color: #111;
        }

        .sales-page .total-row td {
            background: #e9e9e9;
            color: #000;
            padding: 18px;
            font-weight: 750;
            border-top: 2px solid #111;
        }

        .sales-page .count-badge {
            display: inline-block;
            background: #111;
            color: #fff;
            padding: 5px 10px;
            border-radius: 20px;
            font-size: .78rem;
            font-weight: 650;
        }

        .sales-page .empty-state {
            text-align: center;
            padding: 55px 20px;
        }

        .sales-page .empty-icon {
            width: 60px;
            height: 60px;
            margin: 0 auto 16px;
            border-radius: 14px;
            background: #111;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.7rem;
        }

    @@media (max-width: 767px) {
        .sales-page {
            padding-top: 18px;
        }

            .sales-page .page-title {
                font-size: 1.4rem;
            }

            .sales-page .summary-card {
                padding: 17px;
            }

            .sales-page .summary-value {
                font-size: 1.4rem;
            }

            .sales-page .card-heading,
            .sales-page .filter-panel {
                padding: 17px;
            }
    }
</style>

<div class="sales-page">
       <nav class="navbar navbar-expand-xl navbar-dark dashboard-navbar">
        <div class="container-fluid px-3 px-lg-4">
            <a class="navbar-brand fw-bold d-flex align-items-center"
               asp-controller="Admin" asp-action="Dashboard">
                <span class="brand-mark"><i class="bi bi-receipt-cutoff"></i></span>
                MyInvoice
            </a>

            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar" aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav me-auto my-2 my-xl-0 gap-xl-1">
                    <li class="nav-item">
                        <a class="nav-link active" asp-controller="Admin" asp-action="Dashboard">
                            <i class="bi bi-grid-1x2-fill me-1"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Admin" asp-action="SalesList">
                            <i class="bi bi-receipt me-1"></i> Sales
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Admin" asp-action="Debtors">
                            <i class="bi bi-wallet2 me-1"></i> Customer Debts
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Product" asp-action="Index">
                            <i class="bi bi-box-seam me-1"></i> Products
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Product" asp-action="StockSummary">
                            <i class="bi bi-clipboard-data me-1"></i> Stock Summary
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link new-invoice" asp-controller="Staff" asp-action="Create">
                            <i class="bi bi-plus-lg me-1"></i> New Invoice
                        </a>
                    </li>
                </ul>

                <ul class="navbar-nav ms-xl-2">
                    <li class="nav-item">
                        <a class="nav-link logout-link" asp-controller="Account" asp-action="LogIn">
                            <i class="bi bi-box-arrow-right me-1"></i> Logout
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    <div class="container-fluid px-3 px-lg-4">

        <!-- Page heading -->
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <div>
                <h2 class="page-title mb-1">Sales Management</h2>
                <p class="page-subtitle mb-0">
                    Review invoices and monitor sales performance.
                </p>
            </div>

            <a asp-controller="Staff"
               asp-action="Index"
               class="btn-outline-black">
                <i class="bi bi-arrow-left me-2"></i>
                Back to Dashboard
            </a>
        </div>

        <!-- Total sales summary -->
        <div class="row g-3 mb-4">
            <div class="col-12 col-md-6 col-xl-4">
                <div class="summary-card">
                    <div class="d-flex justify-content-between align-items-center gap-3">
                        <div>
                            <div class="summary-label">Total Sales</div>
                            <div class="summary-value">
                                GH₵ @totalSales.ToString("N2")
                            </div>
                            <small class="text-muted">
                                Based on the selected filter
                            </small>
                        </div>

                        <div class="summary-icon">
                            <i class="bi bi-cash-stack"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6 col-xl-4">
                <div class="summary-card">
                    <div class="d-flex justify-content-between align-items-center gap-3">
                        <div>
                            <div class="summary-label">Number of Invoices</div>
                            <div class="summary-value">
                                @sales.Count
                            </div>
                            <small class="text-muted">
                                Invoices matching your search and filter
                            </small>
                        </div>

                        <div class="summary-icon">
                            <i class="bi bi-receipt"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sales table card -->
        <div class="content-card">

            <div class="card-heading">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div>
                        <h5 class="fw-bold mb-1">Sales Records</h5>
                        <p class="text-muted small mb-0">
                            Browse and filter your invoice history.
                        </p>
                    </div>

                    <span class="count-badge">
                        @sales.Count invoice(s)
                    </span>
                </div>
            </div>

            <!-- Search and date filters -->
            <div class="filter-panel">
                <form asp-controller="Staff"
                      asp-action="SalesList"
                      method="get">

                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-md-4 col-lg-3">
                            <label for="filter" class="form-label">
                                <i class="bi bi-calendar3 me-1"></i>
                                Sales Period
                            </label>

                            <select name="filter" id="filter" class="form-select">
                                <option value="today"
                                        selected="@(ViewBag.Filter?.ToString() == "today")">
                                    Today
                                </option>

                                <option value="yesterday"
                                        selected="@(ViewBag.Filter?.ToString() == "yesterday")">
                                    Yesterday
                                </option>

                                <option value="last7"
                                        selected="@(ViewBag.Filter?.ToString() == "last7")">
                                    Last 7 Days
                                </option>

                                <option value="last30"
                                        selected="@(ViewBag.Filter?.ToString() == "last30")">
                                    Last 30 Days
                                </option>

                                <option value="month"
                                        selected="@(ViewBag.Filter?.ToString() == "month")">
                                    This Month
                                </option>

                                <option value="year"
                                        selected="@(ViewBag.Filter?.ToString() == "year")">
                                    This Year
                                </option>

                                <option value="all"
                                        selected="@(ViewBag.Filter?.ToString() == "all")">
                                    All Time
                                </option>
                            </select>
                        </div>

                        <div class="col-12 col-md-5 col-lg-6">
                            <label for="search" class="form-label">
                                <i class="bi bi-search me-1"></i>
                                Search Customer
                            </label>

                            <input type="text"
                                   name="search"
                                   id="search"
                                   class="form-control"
                                   value="@ViewBag.Search"
                                   placeholder="Enter customer name..." />
                        </div>

                        <div class="col-6 col-md-3 col-lg-3">
                            <button type="submit" class="btn btn-black w-100">
                                <i class="bi bi-funnel me-1"></i>
                                Apply Filters
                            </button>
                        </div>
                    </div>
                </form>
            </div>

            <!-- Invoice table -->
            <div class="table-responsive">
                <table class="table" id="salesTable">
                    <thead>
                        <tr>
                            <th>Invoice No.</th>
                            <th>Invoice Date</th>
                            <th>Customer Name</th>
                            <th>Phone Number</th>
                            <th class="text-end">Grand Total</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (sales.Any())
                        {
                            foreach (var item in sales)
                            {
                                <tr>
                                    <td>
                                        <span class="invoice-number">
                                            @item.InvoiceNumber
                                        </span>
                                    </td>

                                    <td>
                                        @item.Date.ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        <span class="customer-name">
                                            @item.CustomerName
                                        </span>
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(item.CustomerPhone)
                                                                        ? "—"
                                                                        : item.CustomerPhone)
                            </td>

                                    <td class="text-end amount">
                                        GH₵ @item.GrandTotal.ToString("N2")
                                    </td>

                                    <td class="text-center">
                                        <a asp-action="EditInvoice"
                                       asp-route-id="@item.InvoiceId"
                                       class="btn btn-danger btn-sm">
                                            <i class="bi bi-pen">Edit</i>
                                    </a> 
                                    <td class="text-center">
                                        <a asp-action="ViewInvoice"
                                       asp-route-id="@item.InvoiceId"
                                          
                                        >

                                            <i class="bi bi-view-list"> View</i>
                                    </a> 
                                    </td>
                                </tr>
                                                }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5">
                                    <div class="empty-state">
                                        <div class="empty-icon">
                                            <i class="bi bi-receipt"></i>
                                        </div>

                                        <h5 class="fw-bold">No sales found</h5>

                                        <p class="text-muted mb-0">
                                            No invoices match the selected period or customer search.
                                        </p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>

                    @if (sales.Any())
                    {
                        <tfoot>
                            <tr class="total-row">
                                <td colspan="4">TOTAL SALES</td>
                                <td class="text-end">
                                    GH₵ @totalSales.ToString("N2")
                                </td>
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>

            <div class="px-4 py-3 border-top">
                <small class="text-muted">
                    <i class="bi bi-shield-check me-1"></i>
                    Sales records for your business.
                </small>
            </div>

        </div>
    </div>
</div>