@model InvoiceManagement.ViewModel.InvoiceViewModel

@{
    Layout = null;

    var companyName = Model.CompanyName ?? "Your Company Name";
    var companyPhone = Model.CompanyPhone ?? "Your Company Phone";

    var isPaid = Model.GrandTotal > 0 && Model.Balance <= 0;
    var isPartial = Model.AmountPaid > 0 && Model.Balance > 0;

    var paymentStatus = isPaid
        ? "PAID"
        : isPartial ? "PARTIALLY PAID" : "UNPAID";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>Invoice - @Model.InvoiceNumber</title>


    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>

        .company-logo-box {
            width: 85px;
            height: 85px;
            flex-shrink: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            background: white;
            padding: 7px;
        }

        .company-logo {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
        }

        .company-details {
            min-width: 0;
        }

        .company-name {
            font-size: 22px;
            font-weight: 800;
            color: #111827;
            text-transform: uppercase;
            overflow-wrap: anywhere;
        }

        .company-contact {
            color: #64748b;
            font-size: 12px;
            margin-top: 5px;
        }

        @@media (max-width: 480px) {
            .company-logo-box {
                width: 55px;
                height: 55px;
            }

            .company-name {
                font-size: 16px;
            }

            .company-contact {
                font-size: 10px;
            }
        }

        * {
            box-sizing: border-box;
        }

        body {
            background: #eef2f7;
            font-family: 'Segoe UI', Arial, sans-serif;
            color: #1e293b;
            font-size: 14px;
        }

        .invoice-wrapper {
            max-width: 900px;
            margin: 40px auto;
        }

        .invoice-card {
            background: #fff;
            border-radius: 14px;
            overflow: hidden;
            box-shadow: 0 10px 40px rgba(15,23,42,.08);
        }

        /* TOP HEADER */

        .invoice-top {
            height: 9px;
            background: #111827;
        }

        .invoice-content {
            padding: 45px 50px;
        }

        .company-name {
            font-size: 25px;
            font-weight: 800;
            letter-spacing: .5px;
            color: #111827;
            text-transform: uppercase;
        }

        .company-address {
            color: #64748b;
            font-size: 13px;
            margin-top: 6px;
        }

        .invoice-heading {
            font-size: 33px;
            font-weight: 800;
            letter-spacing: 3px;
            color: #111827;
        }

        .invoice-number {
            color: #475569;
            font-size: 13px;
            margin-top: 5px;
        }

        .invoice-divider {
            border: 0;
            border-top: 2px solid #e2e8f0;
            margin: 30px 0;
            opacity: 1;
        }

        /* CUSTOMER AND INVOICE INFO */

        .info-label {
            color: #94a3b8;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1.2px;
            text-transform: uppercase;
            margin-bottom: 10px;
        }

        .customer-name {
            font-size: 17px;
            font-weight: 700;
            color: #0f172a;
            margin-bottom: 5px;
        }

        .info-text {
            color: #64748b;
            font-size: 13px;
            line-height: 1.8;
        }

        .status-badge {
            display: inline-block;
            padding: 7px 14px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: .5px;
        }

        .status-paid {
            background: #dcfce7;
            color: #15803d;
        }

        .status-partial {
            background: #fef3c7;
            color: #92400e;
        }

        .status-unpaid {
            background: #fee2e2;
            color: #b91c1c;
        }

        /* PRODUCT TABLE */

        .section-title {
            font-size: 14px;
            font-weight: 750;
            color: #0f172a;
            margin-bottom: 15px;
        }

        .invoice-table {
            width: 100%;
            border-collapse: collapse;
        }

            .invoice-table thead {
                background: #111827;
                color: #fff;
            }

                .invoice-table thead th {
                    padding: 15px 14px;
                    font-size: 11px;
                    text-transform: uppercase;
                    letter-spacing: .7px;
                    font-weight: 600;
                    border: none;
                }

            .invoice-table tbody td {
                padding: 17px 14px;
                font-size: 13px;
                border-bottom: 1px solid #e9edf3;
                vertical-align: middle;
            }

            .invoice-table tbody tr:nth-child(even) {
                background: #f8fafc;
            }

        .product-name {
            font-weight: 600;
            color: #1e293b;
        }

        .money {
            font-variant-numeric: tabular-nums;
            white-space: nowrap;
        }

        /* TOTALS */

        .totals-section {
            margin-top: 30px;
        }

        .totals-box {
            background: #f8fafc;
            border-radius: 10px;
            padding: 22px 25px;
        }

        .total-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            padding: 9px 0;
            font-size: 13px;
        }

        .total-label {
            color: #64748b;
        }

        .total-value {
            font-weight: 650;
            color: #1e293b;
        }

        .total-divider {
            border-top: 1px solid #dbe2ea;
            margin: 12px 0;
        }

        .grand-total-row {
            font-size: 16px;
            font-weight: 800;
            color: #0f172a;
        }

        .balance-row {
            font-size: 16px;
            font-weight: 800;
            color: #b91c1c;
        }

        .balance-paid {
            color: #15803d;
        }

        /* PAYMENT HISTORY */

        .payment-section {
            margin-top: 45px;
        }

        .payment-table {
            width: 100%;
            border-collapse: collapse;
        }

            .payment-table th {
                background: #f1f5f9;
                color: #475569;
                padding: 13px;
                font-size: 11px;
                text-transform: uppercase;
            }

            .payment-table td {
                padding: 13px;
                border-bottom: 1px solid #e2e8f0;
                font-size: 12px;
            }

        /* FOOTER */

        .invoice-footer {
            margin-top: 55px;
            padding-top: 25px;
            border-top: 1px solid #e2e8f0;
            text-align: center;
        }

        .thank-you {
            font-size: 17px;
            font-weight: 750;
            color: #111827;
        }

        .footer-message {
            color: #64748b;
            font-size: 12px;
            margin-top: 8px;
        }

        .return-policy {
            margin-top: 15px;
            font-size: 11px;
            font-weight: 700;
            color: #475569;
            text-transform: uppercase;
            letter-spacing: .5px;
        }

        /* ACTION BUTTONS */

        .action-bar {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-bottom: 20px;
        }

        .action-btn {
            padding: 11px 20px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
        }

        /* PRINT SETTINGS */

        @@page {
            size: A4;
            margin: 12mm;
        }

        @@media print {
            body {
                background: white !important;
                margin: 0;
                padding: 0;
                font-size: 12px;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            .no-print {
                display: none !important;
            }

            .invoice-wrapper {
                margin: 0;
                max-width: 100%;
            }

            .invoice-card {
                box-shadow: none !important;
                border-radius: 0;
            }

            .invoice-content {
                padding: 20px 15px;
            }

            .invoice-table thead {
                background: #111827 !important;
                color: white !important;
            }

            .invoice-table thead {
                display: table-header-group;
            }

            .invoice-table tr {
                break-inside: avoid;
                page-break-inside: avoid;
            }

            .totals-section,
            .totals-box {
                break-inside: avoid;
                page-break-inside: avoid;
            }

            .invoice-footer {
                margin-top: 35px;
            }
        }

        @@media (max-width: 768px) {
            .invoice-wrapper {
                margin: 15px;
            }

            .invoice-content {
                padding: 25px 20px;
            }

            .company-name {
                font-size: 20px;
            }

            .invoice-heading {
                font-size: 25px;
            }

            .invoice-table thead th,
            .invoice-table tbody td {
                padding: 11px 9px;
                font-size: 11px;
            }

            .action-bar {
                flex-wrap: wrap;
            }
        }
    </style>
</head>

<body>

    <div class="invoice-wrapper">

        <!-- ACTION BUTTONS -->
        <div class="action-bar no-print">

            <button type="button"
                    onclick="window.history.back()"
                    class="btn btn-outline-secondary action-btn">
                ← Back
            </button>

            <button type="button"
                    onclick="window.print()"
                    class="btn btn-dark action-btn">
                🖨 Print / Save PDF
            </button>

        </div>

        <!-- INVOICE CARD -->
        <div class="invoice-card">

            <div class="invoice-top"></div>

            <div class="invoice-content">

                <!-- HEADER -->
                <!-- COMPANY AND INVOICE HEADER -->
                <!-- COMPANY HEADER -->
                <div class="row align-items-center g-3 mb-4">

                    <!-- COMPANY LOGO AND INFORMATION -->
                    <div class="col-7">

                        <div class="d-flex align-items-center gap-3">

                            @if (!string.IsNullOrWhiteSpace(Model.CompanyLogo))
                            {
                                <div class="company-logo-box">
                                    <img src="@Url.Content(Model.CompanyLogo)"
                                         alt="Company Logo"
                                         class="company-logo" />
                                </div>
                            }

                            <div class="company-details">

                                <div class="company-name">
                                    @Model.CompanyName
                                </div>

                                @if (!string.IsNullOrWhiteSpace(Model.Address))
                                {
                                    <div class="company-contact">
                                        📍 @Model.Address
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(Model.CompanyPhone))
                                {
                                    <div class="company-contact">
                                        ☎ @Model.CompanyPhone
                                    </div>
                                }

                            </div>

                        </div>

                    </div>

                    <!-- INVOICE DETAILS -->
                    <div class="col-5 text-end">

                        <div class="invoice-heading">
                            INVOICE
                        </div>

                        <div class="invoice-number mt-2">
                            <strong>No:</strong> @Model.InvoiceNumber
                        </div>

                        <div class="invoice-number mt-1">
                            <strong>Date:</strong>
                            @Model.InvoiceDate.ToString("dd MMM yyyy")
                        </div>

                        <div class="mt-3">
                            <span class="status-badge @(isPaid
                                                                                                                      ? "status-paid"
                                                                                                                      : isPartial ? "status-partial" : "status-unpaid")">
                                @paymentStatus
                            </span>
                        </div>

                    </div>

                </div>


                <hr class="invoice-divider" />

                <!-- CUSTOMER INFORMATION -->
                <div class="row g-4 mb-5">

                    <div class="col-7">

                        <div class="info-label">
                            Bill To
                        </div>

                        <div class="customer-name">
                            @Model.CustomerName
                        </div>

                        <div class="info-text">

                            @if (!string.IsNullOrWhiteSpace(Model.CustomerPhone))
                            {
                                <div>
                                    Phone: @Model.CustomerPhone
                                </div>
                            }

                        </div>

                    </div>

                    <div class="col-5 text-end">

                        <div class="info-label">
                            Invoice Details
                        </div>

                        <div class="info-text">

                            <div>
                                <strong>Invoice Date:</strong>
                                @Model.InvoiceDate.ToString("dd MMM yyyy")
                            </div>

                            <div class="mt-2">
                                <span class="status-badge @(isPaid
                                                                                                                                                      ? "status-paid"
                                                                                                                                                      : isPartial
                                                                                                                                                          ? "status-partial"
                                                                                                                                                          : "status-unpaid")">

                                    @paymentStatus

                                </span>
                            </div>

                        </div>

                    </div>

                </div>

                <!-- ITEMS -->
                <div class="section-title">
                    Invoice Items
                </div>

                <div class="table-responsive">

                    <table class="invoice-table">

                        <thead>
                            <tr>
                                <th>Product Description</th>
                                <th class="text-center">Qty</th>
                                <th class="text-end">Unit Price</th>
                                <th class="text-end">Amount</th>
                            </tr>
                        </thead>

                        <tbody>

                            @if (Model.Items != null && Model.Items.Any())
                            {
                                foreach (var item in Model.Items)
                                {
                                    <tr>

                                        <td class="product-name">
                                            @item.ProductName
                                        </td>

                                        <td class="text-center">
                                            @item.Quantity
                                        </td>

                                        <td class="text-end money">
                                            GH₵ @item.SellingPrice.ToString("N2")
                                        </td>

                                        <td class="text-end money fw-semibold">
                                            GH₵ @item.TotalPrice.ToString("N2")
                                        </td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4"
                                        class="text-center text-muted py-4">
                                        No invoice items available.
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

                <!-- TOTALS -->
                <div class="row justify-content-end totals-section">
                    <div class="col-md-6 col-lg-5">
                        <div class="totals-box">
                            <div class="total-row">
                                <span class="total-label">Subtotal</span>
                                <span class="total-value money">GH₵ @Model.Subtotal.ToString("N2")</span>
                            </div>

                            @if (Model.TaxAmount > 0)
                            {
                                <div class="total-row">
                                    <span class="total-label">
                                        @if (Model.TaxType == "Percentage")
                                        {
                                            <text>Tax (@Model.TaxValue.ToString("0.##")%)</text>
                                        }
                                        else
                                        {
                                            <text>Fixed Tax</text>
                                        }
                                    </span>
                                    <span class="total-value money">GH₵ @Model.TaxAmount.ToString("N2")</span>
                                </div>
                            }

                            <div class="total-divider"></div>
                            <div class="total-row grand-total-row">
                                <span>Grand Total</span>
                                <span class="money">GH₵ @Model.GrandTotal.ToString("N2")</span>
                            </div>
                            <div class="total-row">
                                <span class="total-label">Amount Paid</span>
                                <span class="total-value money" style="color:#15803d;">
                                    GH₵ @Model.AmountPaid.ToString("N2")
                                </span>
                            </div>
                            <div class="total-divider"></div>
                            <div class="total-row balance-row @(isPaid ? "balance-paid" : "")">
                                <span>Balance Due</span>
                                <span class="money">GH₵ @Model.Balance.ToString("N2")</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- PAYMENT HISTORY -->
                @if (Model.Payments != null && Model.Payments.Any())
                {
                    <div class="payment-section">

                        <div class="section-title">
                            Payment History
                        </div>

                        <div class="table-responsive">

                            <table class="payment-table">

                                <thead>
                                    <tr>
                                        <th>Payment Date</th>
                                        <th>Payment Method</th>
                                        <th class="text-end">
                                            Amount Paid
                                        </th>
                                    </tr>
                                </thead>

                                <tbody>

                                    @foreach (var payment in Model.Payments
                                                                    .OrderBy(p => p.PaymentDate))
                                    {
                                        <tr>

                                            <td>
                                                @payment.PaymentDate.ToString("dd MMM yyyy")
                                            </td>

                                            <td>
                                                @payment.Method
                                            </td>

                                            <td class="text-end money fw-semibold">
                                                GH₵ @payment.Amount.ToString("N2")
                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>

                    </div>
                }

                <!-- FOOTER -->
                <div class="invoice-footer">

                    <div class="thank-you">
                        Thank You For Your Business!
                    </div>

                    <div class="footer-message">
                        We appreciate your purchase and look forward
                        to serving you again.
                    </div>

                    <div class="return-policy">
                        Goods Sold Are Not Returnable
                    </div>

                    <div class="footer-message mt-3">
                        @companyName
                        &nbsp; | &nbsp;
                        @Model.CompanyPhone
                    </div>

                    <div class="footer-message mt-2">
                        Generated by ALFRED
                    </div>

                </div>

            </div>

        </div>

    </div>

</body>
</html>

