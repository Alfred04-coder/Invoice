@model IEnumerable<InvoiceManagement.ViewModel.InvoiceViewModel>

@{
    ViewData["Title"] = "Debtors";

    var debtors = Model?.ToList() ?? new List<InvoiceManagement.ViewModel.InvoiceViewModel>();
    var totalDebt = debtors.Sum(x => x.Balance);
    var totalSales = debtors.Sum(x => x.GrandTotal);
    var totalPaid = debtors.Sum(x => x.AmountPaid);
}

<style>
    .dashboard-page {
        background: #f4f4f4;
        min-height: 100vh;
        color: #171717;
        padding-bottom: 40px;
    }

    .dashboard-navbar {
        background: #080808;
        border-bottom: 3px solid #333;
    }

        .dashboard-navbar .navbar-brand {
            color: #fff;
            letter-spacing: -.3px;
            font-size: 1.25rem;
        }

        .dashboard-navbar .brand-mark {
            display: inline-flex;
            width: 36px;
            height: 36px;
            align-items: center;
            justify-content: center;
            background: #fff;
            color: #080808;
            border-radius: 10px;
            margin-right: 8px;
        }

        .dashboard-navbar .nav-link {
            color: #d0d0d0;
            font-size: .88rem;
            font-weight: 600;
            padding: 12px 13px !important;
            border-radius: 7px;
            transition: .2s ease;
        }

            .dashboard-navbar .nav-link:hover,
            .dashboard-navbar .nav-link.active {
                background: #292929;
                color: #fff;
            }

            .dashboard-navbar .nav-link.new-invoice {
                background: #fff;
                color: #111;
                margin-left: 4px;
            }

                .dashboard-navbar .nav-link.new-invoice:hover {
                    background: #e5e5e5;
                    color: #000;
                }

            .dashboard-navbar .nav-link.logout-link {
                color: #ffb8b8;
            }

                .dashboard-navbar .nav-link.logout-link:hover {
                    background: #351818;
                    color: #fff;
                }

    .dashboard-content {
        padding: 28px 0;
    }

    .dashboard-title {
        font-size: clamp(1.5rem, 2vw, 2rem);
        font-weight: 800;
        letter-spacing: -.7px;
        color: #101010;
        margin-bottom: 5px;
    }

    .dashboard-subtitle {
        color: #737373;
        margin-bottom: 0;
        font-size: .93rem;
    }

    .date-chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 14px;
        background: #fff;
        border: 1px solid #dedede;
        border-radius: 10px;
        color: #333;
        font-size: .86rem;
        font-weight: 650;
    }
    .debtors-page {
        background: #f2f2f2;
        min-height: 100vh;
        padding: 28px 0 45px;
        color: #171717;
    }

        .debtors-page .page-heading {
            font-size: 1.65rem;
            font-weight: 750;
            letter-spacing: -.5px;
            color: #000;
        }

        .debtors-page .page-subtitle {
            color: #666;
            font-size: .92rem;
        }

        .debtors-page .summary-card {
            background: #fff;
            border: 1px solid #dedede;
            border-radius: 12px;
            padding: 21px;
            height: 100%;
            box-shadow: 0 4px 14px rgba(0, 0, 0, .06);
            border-top: 4px solid #111;
        }

        .debtors-page .summary-label {
            color: #666;
            font-size: .83rem;
            font-weight: 600;
            margin-bottom: 10px;
        }

        .debtors-page .summary-value {
            color: #000;
            font-size: 1.4rem;
            font-weight: 750;
            overflow-wrap: anywhere;
        }

        .debtors-page .summary-icon {
            width: 44px;
            height: 44px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            flex-shrink: 0;
            background: #111;
            color: #fff;
        }

        .debtors-page .icon-debt,
        .debtors-page .icon-sales,
        .debtors-page .icon-paid {
            background: #111;
            color: #fff;
        }

        .debtors-page .main-card {
            border: 1px solid #dedede;
            border-radius: 13px;
            background: #fff;
            box-shadow: 0 5px 20px rgba(0, 0, 0, .07);
            overflow: hidden;
        }

        .debtors-page .card-header-custom {
            padding: 21px 24px;
            border-bottom: 1px solid #ddd;
            background: #fff;
        }

        .debtors-page .table {
            margin-bottom: 0;
            white-space: nowrap;
        }

            .debtors-page .table thead th {
                background: #111;
                color: #fff;
                font-size: .75rem;
                font-weight: 700;
                letter-spacing: .5px;
                text-transform: uppercase;
                padding: 16px 18px;
                border: 0;
            }

            .debtors-page .table tbody td {
                padding: 17px 18px;
                border-color: #e8e8e8;
                color: #292929;
                font-size: .88rem;
                vertical-align: middle;
            }

            .debtors-page .table tbody tr:hover td {
                background: #f5f5f5;
            }

        .debtors-page .invoice-number {
            color: #000;
            font-weight: 750;
        }

        .debtors-page .customer-name {
            color: #111;
            font-weight: 650;
        }

        .debtors-page .balance-badge {
            background: #ededed;
            color: #000;
            border: 1px solid #d2d2d2;
            border-radius: 6px;
            padding: 7px 10px;
            font-weight: 750;
            display: inline-block;
        }

        .debtors-page .paid-amount {
            color: #333;
            font-weight: 650;
        }

        .debtors-page .total-row td {
            background: #e9e9e9;
            color: #000;
            padding: 18px;
            font-weight: 750;
            border-top: 2px solid #111;
        }

        .debtors-page .search-box {
            max-width: 300px;
            position: relative;
        }

            .debtors-page .search-box input {
                border-radius: 8px;
                border: 1px solid #ccc;
                padding: 10px 13px 10px 37px;
                font-size: .85rem;
                background: #fff;
                color: #111;
            }

                .debtors-page .search-box input:focus {
                    border-color: #111;
                    box-shadow: 0 0 0 3px rgba(0, 0, 0, .1);
                }

        .debtors-page .search-icon {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: #555;
            pointer-events: none;
        }

        .debtors-page .back-button {
            border: 1px solid #111;
            border-radius: 8px;
            padding: 9px 15px;
            color: #fff;
            font-weight: 600;
            background: #111;
            text-decoration: none;
            transition: .2s ease;
        }

            .debtors-page .back-button:hover {
                background: #333;
                color: #fff;
            }

        .debtors-page .empty-state {
            padding: 55px 20px;
            text-align: center;
        }

        .debtors-page .empty-icon {
            width: 60px;
            height: 60px;
            margin: 0 auto 16px;
            border-radius: 14px;
            background: #111;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.7rem;
        }

        .debtors-page .text-danger {
            color: #111 !important;
        }

        .debtors-page .text-success {
            color: #333 !important;
        }

        .debtors-page .text-muted {
            color: #707070 !important;
        }

        .debtors-page .border-top {
            border-color: #ddd !important;
        }

    @@media (max-width: 767px) {
        .debtors-page {
            padding-top: 18px;
        }

            .debtors-page .page-heading {
                font-size: 1.4rem;
            }

            .debtors-page .summary-card {
                padding: 16px;
            }

            .debtors-page .summary-value {
                font-size: 1.15rem;
            }

            .debtors-page .card-header-custom {
                padding: 18px;
            }

            .debtors-page .search-box {
                max-width: 100%;
                width: 100%;
            }
    }
</style>

<div class="debtors-page">
    <nav class="navbar navbar-expand-xl navbar-dark dashboard-navbar">
        <div class="container-fluid px-3 px-lg-4">
            <a class="navbar-brand fw-bold d-flex align-items-center"
               asp-controller="Admin" asp-action="Dashboard">
                <span class="brand-mark"><i class="bi bi-receipt-cutoff"></i></span>
                MyInvoice
            </a>

            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar" aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav me-auto my-2 my-xl-0 gap-xl-1">
                    <li class="nav-item">
                        <a class="nav-link active" asp-controller="Admin" asp-action="Dashboard">
                            <i class="bi bi-grid-1x2-fill me-1"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Admin" asp-action="SalesList">
                            <i class="bi bi-receipt me-1"></i> Sales
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Admin" asp-action="Debtors">
                            <i class="bi bi-wallet2 me-1"></i> Customer Debts
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Product" asp-action="Index">
                            <i class="bi bi-box-seam me-1"></i> Products
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Product" asp-action="StockSummary">
                            <i class="bi bi-clipboard-data me-1"></i> Stock Summary
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link new-invoice" asp-controller="Staff" asp-action="Create">
                            <i class="bi bi-plus-lg me-1"></i> New Invoice
                        </a>
                    </li>
                </ul>

                <ul class="navbar-nav ms-xl-2">
                    <li class="nav-item">
                        <a class="nav-link logout-link" asp-controller="Account" asp-action="LogIn">
                            <i class="bi bi-box-arrow-right me-1"></i> Logout
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    <div class="container-fluid px-3 px-lg-4">

        <!-- Page heading -->
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <div>
                <h2 class="page-heading mb-1">Debtors Management</h2>
                <p class="page-subtitle mb-0">
                    Monitor outstanding customer invoices and balances.
                </p>
            </div>

            <a asp-controller="Staff"
               asp-action="Index"
               class="back-button">
                <i class="bi bi-arrow-left me-2"></i> Back to Dashboard
            </a>
        </div>

        <!-- Summary cards -->
        <div class="row g-3 mb-4">

            <div class="col-12 col-md-4">
                <div class="summary-card">
                    <div class="d-flex justify-content-between align-items-start gap-3">
                        <div>
                            <div class="summary-label">Total Outstanding Debt</div>
                            <div class="summary-value text-danger">
                                GH₵ @totalDebt.ToString("N2")
                            </div>
                            <small class="text-muted">Amount customers still owe</small>
                        </div>
                        <div class="summary-icon icon-debt">
                            <i class="bi bi-wallet2"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-4">
                <div class="summary-card">
                    <div class="d-flex justify-content-between align-items-start gap-3">
                        <div>
                            <div class="summary-label">Total Invoice Value</div>
                            <div class="summary-value">
                                GH₵ @totalSales.ToString("N2")
                            </div>
                            <small class="text-muted">Value of outstanding invoices</small>
                        </div>
                        <div class="summary-icon icon-sales">
                            <i class="bi bi-receipt"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-4">
                <div class="summary-card">
                    <div class="d-flex justify-content-between align-items-start gap-3">
                        <div>
                            <div class="summary-label">Amount Already Paid</div>
                            <div class="summary-value text-success">
                                GH₵ @totalPaid.ToString("N2")
                            </div>
                            <small class="text-muted">Payments received on these invoices</small>
                        </div>
                        <div class="summary-icon icon-paid">
                            <i class="bi bi-check2-circle"></i>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- Debtors table -->
        <div class="main-card">

            <div class="card-header-custom">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div>
                        <h5 class="fw-bold mb-1">Outstanding Invoices</h5>
                        <div class="text-muted small">
                            <span id="debtorCount">@debtors.Count</span> invoice(s) with unpaid balances
                        </div>
                    </div>

                    <div class="search-box">
                        <i class="bi bi-search search-icon"></i>
                        <input type="text"
                               id="debtorSearch"
                               class="form-control"
                               placeholder="Search invoice or customer..."
                               aria-label="Search debtors" />
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table" id="debtorsTable">
                    <thead>
                        <tr>
                            <th>Invoice No.</th>
                            <th>Invoice Date</th>
                            <th>Customer Name</th>
                            <th class="text-end">Grand Total</th>
                            <th class="text-end">Amount Paid</th>
                            <th class="text-end">Balance Due</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (debtors.Any())
                        {
                            foreach (var item in debtors)
                            {
                                <tr>
                                    <td>
                                        <span class="invoice-number">
                                            @item.InvoiceNumber
                                        </span>
                                    </td>
                                    <td class="text-muted">
                                        @item.InvoiceDate.ToString("dd MMM yyyy")
                                    </td>
                                    <td>
                                        <span class="customer-name">
                                            @item.CustomerName
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        GH₵ @item.GrandTotal.ToString("N2")
                                    </td>
                                    <td class="text-end paid-amount">
                                        GH₵ @item.AmountPaid.ToString("N2")
                                    </td>
                                    <td class="text-end">
                                        <span class="balance-badge">
                                            GH₵ @item.Balance.ToString("N2")
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr id="emptyRow">
                                <td colspan="6">
                                    <div class="empty-state">
                                        <div class="empty-icon">
                                            <i class="bi bi-check2-circle"></i>
                                        </div>
                                        <h5 class="fw-bold">All caught up!</h5>
                                        <p class="text-muted mb-0">
                                            There are no outstanding customer debts to display.
                                        </p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>

                    @if (debtors.Any())
                    {
                        <tfoot>
                            <tr class="total-row" id="totalsRow">
                                <td colspan="3">TOTAL</td>
                                <td class="text-end">
                                    GH₵ @totalSales.ToString("N2")
                                </td>
                                <td class="text-end text-success">
                                    GH₵ @totalPaid.ToString("N2")
                                </td>
                                <td class="text-end text-danger">
                                    GH₵ @totalDebt.ToString("N2")
                                </td>
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>

            <div class="px-4 py-3 border-top bg-white">
                <small class="text-muted">
                    <i class="bi bi-shield-check me-1"></i>
                    Outstanding balances are shown for your company only.
                </small>
            </div>
        </div>

    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.getElementById("debtorSearch");
        const table = document.getElementById("debtorsTable");
        const countDisplay = document.getElementById("debtorCount");

        if (!searchInput || !table) return;

        searchInput.addEventListener("input", function () {
            const searchTerm = this.value.toLowerCase().trim();
            const rows = table.querySelectorAll("tbody tr");
            let visibleCount = 0;

            rows.forEach(function (row) {
                if (row.id === "emptyRow") return;

                const matches = row.textContent.toLowerCase().includes(searchTerm);
                row.style.display = matches ? "" : "none";

                if (matches) visibleCount++;
            });

            if (countDisplay) {
                countDisplay.textContent = visibleCount;
            }

            const totalsRow = document.getElementById("totalsRow");
            if (totalsRow) {
                totalsRow.style.display = searchTerm ? "none" : "";
            }

            let noResultsRow = document.getElementById("noSearchResults");

            if (visibleCount === 0 && rows.length > 0 &&
                !document.getElementById("emptyRow")) {
                if (!noResultsRow) {
                    noResultsRow = document.createElement("tr");
                    noResultsRow.id = "noSearchResults";
                    noResultsRow.innerHTML =
                        '<td colspan="6" class="text-center py-5 text-muted">' +
                        '<i class="bi bi-search me-2"></i>' +
                        'No matching invoices found.</td>';
                    table.querySelector("tbody").appendChild(noResultsRow);
                }
            } else if (noResultsRow) {
                noResultsRow.remove();
            }
        });
    });
</script>